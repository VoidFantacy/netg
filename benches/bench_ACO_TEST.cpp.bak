// 辅助函数：打印JSON类型信息
std::string json_type_str(const nlohmann::json& j) {
    if (j.is_null()) return "null";
    if (j.is_boolean()) return "boolean";
    if (j.is_number()) return "number";
    if (j.is_string()) return "string";
    if (j.is_array()) return "array";
    if (j.is_object()) return "object";
    return "unknown";
}

double train_ACO(const DataLoader &data_loader, acsg::IndexACSG &index)
{
    try {
        using idx_t = faiss::idx_t;
        std::cerr << "Starting ACO training\n";
        double train_time_sec;
        {
            auto [nq, xq] = data_loader.load_query("acpg"); 
            std::cerr << "Loaded ACPG query data: " << nq << " queries\n";
            // === 修改开始 ===
            auto [k, gt] = data_loader.load_gt("acpg");
            std::cout << "\n[DEBUG CHECK] Real-time k value check:\n";
            std::cout << "  - k (from load_gt) = " << k << " (Expect 100)\n";
            std::cout << "  - nq (queries)     = " << nq << "\n";
            if (k == nq) {
                std::cout << "  [!!!] CRITICAL WARNING: k equals nq! DataLoader bug persists!\n";
            }
            std::cout << "==========================================\n\n";
            // === 修改结束 ===  

            if (!xq) throw std::runtime_error("train xq is null");
            if (!gt) throw std::runtime_error("train gt is null");
            
            Timer timer;
            index.antSearch(nq, xq.get(), k, gt.get());
            train_time_sec = timer.elapsed_ms() * 1e-3;
            std::cout << "Training Time = " << train_time_sec << " [s]" << std::endl;
        }
        return train_time_sec;
    } catch (const std::exception& e) {
        std::cerr << "ERROR in train_ACO: " << e.what() << "\n";
        throw;
    }
}

std::tuple<double, double, double> compute_qps_recall_ACO(
    acsg::IndexACSG &index, const int nq,
    const std::unique_ptr<float[]> &xq, const int k,
    const std::unique_ptr<faiss::idx_t[]> &gt)
{
    try {
        using idx_t = faiss::idx_t;
        std::cerr << "Computing ACO QPS for nq=" << nq << ", k=" << k << "\n";

        if (!xq) throw std::runtime_error("xq is null");
        if (!gt) throw std::runtime_error("gt is null");
        if (nq <= 0 || k <= 0) throw std::runtime_error("invalid nq or k");

        std::unique_ptr<idx_t[]> I(new idx_t[nq * k]);
        std::unique_ptr<float[]> D(new float[nq * k]);

        Timer timer;
        index.search_ACO(nq, xq.get(), k, D.get(), I.get());
        auto elapsed = timer.elapsed_ns() * 1e-9;

        float qps = nq / elapsed;
        float r_at_k = recall_at_k(nq, k, k, I, 100, gt);
        std::cout << "ACO QPS = " << qps << " [q/s], R@k = " << r_at_k << std::endl;
        return {qps, r_at_k, elapsed};
    } catch (const std::exception& e) {
        std::cerr << "ERROR in compute_qps_recall_ACO: " << e.what() << "\n";
        throw;
    }
}

// 函数声明（恢复为5个参数，与旧版本一致）
std::tuple<double, double, double> compute_qps_recall(
    acsg::IndexACSG &index, const int nq,
    const std::unique_ptr<float[]> &xq, const int k,
    const std::unique_ptr<faiss::idx_t[]> &gt
);

// 函数定义（删除current_search_L参数，通过index获取search_L）
std::tuple<double, double, double> compute_qps_recall(
    acsg::IndexACSG &index, const int nq,
    const std::unique_ptr<float[]> &xq, const int k,
    const std::unique_ptr<faiss::idx_t[]> &gt
) {
    try {
        using idx_t = faiss::idx_t;
        // 直接从index获取当前search_L（无需新增参数）
        int current_search_L = index.acsg.search_L;
        std::cerr << "=== Starting compute_qps_recall (search_L=" << current_search_L << ") ===" << std::endl;
        std::cerr << "Parameters: nq=" << nq << ", k=" << k 
                  << ", index.d=" << index.d << ", index.ntotal=" << index.ntotal << std::endl;

        // 1. 索引核心结构完整性检查（基于Graph结构体的N/K成员）
        if (!index.acsg.final_graph) {
            throw std::runtime_error("index.acsg.final_graph is null (graph structure missing)");
        }
        if (index.acsg.final_graph->N != index.ntotal) {
            throw std::runtime_error("graph node count mismatch: graph.N=" + std::to_string(index.acsg.final_graph->N) + 
                                    ", index.ntotal=" + std::to_string(index.ntotal));
        }
        if (index.acsg.final_graph->K != index.nsg_R) {
            throw std::runtime_error("graph K mismatch: graph.K=" + std::to_string(index.acsg.final_graph->K) + 
                                    ", nsg_R=" + std::to_string(index.nsg_R));
        }

        // 2. 搜索参数有效性检查（用current_search_L替代新增参数）
        if (current_search_L <= 0) {
            throw std::invalid_argument("invalid search_L (must be positive): " + std::to_string(current_search_L));
        }
        if (current_search_L > index.ntotal) {
            throw std::invalid_argument("search_L (" + std::to_string(current_search_L) + 
                                      ") exceeds total vectors (" + std::to_string(index.ntotal) + ")");
        }

        // 3. 索引内部向量存储检查
        auto flat_index = dynamic_cast<faiss::IndexFlat*>(index.storage);
        if (!flat_index) {
            throw std::runtime_error("index.storage is not IndexFlat (invalid vector storage)");
        }
        if (flat_index->ntotal != index.ntotal || flat_index->d != index.d) {
            throw std::runtime_error("storage mismatch: flat_ntotal=" + std::to_string(flat_index->ntotal) + 
                                    ", index_ntotal=" + std::to_string(index.ntotal) + 
                                    ", flat_d=" + std::to_string(flat_index->d) + 
                                    ", index_d=" + std::to_string(index.d));
        }

        // 4. 输入参数合法性检查
        if (nq <= 0) throw std::invalid_argument("nq must be positive: " + std::to_string(nq));
        if (k <= 0) throw std::invalid_argument("k must be positive: " + std::to_string(k));
        if (k > index.ntotal) throw std::invalid_argument("k (" + std::to_string(k) + ") exceeds index size (" + std::to_string(index.ntotal) + ")");
        if (!xq) throw std::runtime_error("xq is null (query vectors not provided)");
        if (!gt) throw std::runtime_error("gt is null (ground truth not provided)");

        // 5. 结果内存分配检查
        const size_t result_size = static_cast<size_t>(nq) * k;
        std::unique_ptr<idx_t[]> I;
        std::unique_ptr<float[]> D;
        try {
            I = std::make_unique<idx_t[]>(result_size);
            D = std::make_unique<float[]>(result_size);
            std::fill(I.get(), I.get() + result_size, -1);  // 初始化无效值便于检查
            std::fill(D.get(), D.get() + result_size, 0.0f);
        } catch (const std::bad_alloc& e) {
            throw std::runtime_error("memory allocation failed (size=" + std::to_string(result_size) + "): " + e.what());
        }

        // 6. 执行搜索并捕获异常（包含search_L上下文）
        Timer timer;
        std::string faiss_error_msg;
        try {
            std::cerr << "DEBUG: index.is_built = " << std::boolalpha << index.is_built << std::endl;

            std::cerr << "Calling index.search(nq=" << nq << ", k=" << k << ", search_L=" << current_search_L << ")" << std::endl;

            index.search(nq, xq.get(), k, D.get(), I.get());
        } catch (const faiss::FaissException& e) {
            faiss_error_msg = std::string(e.what());
            if (faiss_error_msg.find("out of bounds") != std::string::npos) {
                throw std::runtime_error("Faiss out-of-bounds: " + faiss_error_msg + 
                                        " (invalid neighbor index in graph at search_L=" + std::to_string(current_search_L) + ")");
            } else if (faiss_error_msg.find("null pointer") != std::string::npos) {
                throw std::runtime_error("Faiss null pointer: " + faiss_error_msg + 
                                        " (index internal structure corrupted)");
            } else {
                throw std::runtime_error("Faiss error: " + faiss_error_msg);
            }
        } catch (const std::exception& e) {
            throw std::runtime_error("search failed: " + std::string(e.what()));
        }
        const auto elapsed = timer.elapsed_ns() * 1e-9;

        // 7. 搜索结果有效性检查
        if (elapsed <= 0) {
            throw std::runtime_error("invalid search time (" + std::to_string(elapsed) + "s) - possible search logic failure");
        }
        // 检查前10个查询的第一个结果是否有效
        for (int i = 0; i < std::min(10, nq); ++i) {
            if (I[i * k] == -1 && k > 0) {
                std::cerr << "WARNING: query " << i << " has invalid first neighbor (-1)" << std::endl;
            }
        }

        // 8. 计算召回率并返回结果（3个元素，匹配结构化绑定）
        const float r_at_k = recall_at_k(nq, k, k, I, 100, gt);
        std::cout << "Standard QPS = " << nq / elapsed << " [q/s], R@k = " << r_at_k << std::endl;
        return {nq / elapsed, r_at_k, elapsed};

    } catch (const std::exception& e) {
        // 错误信息包含search_L上下文
        int current_search_L = index.acsg.search_L;
        std::cerr << "FATAL ERROR in compute_qps_recall (search_L=" << current_search_L << "): " << e.what() << std::endl;
        std::cerr << "Error context: " << std::endl;
        std::cerr << "  index.is_built=" << std::boolalpha << index.is_built << std::endl;
        std::cerr << "  index.is_trained=" << std::boolalpha << index.is_trained << std::endl;
        std::cerr << "  graph.N=" << (index.acsg.final_graph ? std::to_string(index.acsg.final_graph->N) : "null") << std::endl;
        std::cerr << "  graph.K=" << (index.acsg.final_graph ? std::to_string(index.acsg.final_graph->K) : "null") << std::endl;
        std::cerr << "  index.nsg_R=" << index.nsg_R << std::endl;
        throw;  // 重新抛出异常供上层处理
    }
}


nlohmann::json measure_search_performance(acsg::IndexACSG &index,
                                          const DataLoader &data_loader)
{
    try {
        size_t d = data_loader.dim();
        auto [nq, xq] = data_loader.load_query();
        auto [k, gt] = data_loader.load_gt();
        std::cerr << "Measuring standard search performance: nq=" << nq 
                  << ", d=" << d << ", k=" << k << "\n";

        if (!xq || !gt) throw std::runtime_error("query data or gt is null");
        if (nq <= 0 || k <= 0) throw std::runtime_error("invalid query parameters");

        nlohmann::json results = nlohmann::json::array();
        std::cerr << "Initialized results as " << json_type_str(results) << "\n";

        for (int search_L : {1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024})
        {
            std::cerr << "\nProcessing search_L=" << search_L << " (standard)\n";
            index.acsg.search_L = search_L;

            auto [qps, r_at_k, elapsed] = compute_qps_recall(index, nq, xq, 10, gt);

            nlohmann::json result;
            result["search_L"] = search_L;
            result["qps"] = qps;
            result["r_at_k"] = r_at_k;
            result["search_time"] = elapsed;

            if (!results.is_array()) {
                throw std::runtime_error("results is not array before push_back (search_L=" + 
                                        std::to_string(search_L) + ", type=" + json_type_str(results) + ")");
            }
            results.push_back(result);
            std::cerr << "Added search_L=" << search_L << " to standard results (new size=" << results.size() << ")\n";
        }

        return results;
    } catch (const std::exception& e) {
        std::cerr << "ERROR in measure_search_performance: " << e.what() << "\n";
        throw;
    }
}

nlohmann::json measure_search_performance_ACO(acsg::IndexACSG &index,
                                              const DataLoader &data_loader)
{
