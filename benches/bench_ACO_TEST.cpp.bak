        if (!xq || !gt) throw std::runtime_error("query data or gt is null");
        if (nq <= 0 || k <= 0) throw std::runtime_error("invalid query parameters");

        nlohmann::json results = nlohmann::json::array();
        std::cerr << "Initialized ACO results as " << json_type_str(results) << "\n";

        for (int search_L : {1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024})
        {
            std::cerr << "\nProcessing search_L=" << search_L << " (ACO)\n";
            index.acsg.search_L = search_L;

            auto [qps, r_at_k, elapsed] = compute_qps_recall_ACO(index, nq, xq, 10, gt);

            nlohmann::json result;
            result["search_L"] = search_L;
            result["qps"] = qps;
            result["r_at_k"] = r_at_k;
            result["elapsed"] = elapsed;

            if (!results.is_array()) {
                throw std::runtime_error("ACO results is not array before push_back (search_L=" + 
                                        std::to_string(search_L) + ", type=" + json_type_str(results) + ")");
            }
            results.push_back(result);
            std::cerr << "Added search_L=" << search_L << " to ACO results (new size=" << results.size() << ")\n";
        }

        return results;
    } catch (const std::exception& e) {
        std::cerr << "ERROR in measure_search_performance_ACO: " << e.what() << "\n";
        throw;
    }
}

double measure_search_performance_brute_force(acsg::IndexACSG &index,
                                              const DataLoader &data_loader)
{
    try {
        size_t d = data_loader.dim();
        auto [nb, xb] = data_loader.load_base();
        auto [nq, xq] = data_loader.load_query();
        std::cerr << "Measuring brute force time: nq=" << nq << ", d=" << d << "\n";

        using idx_t = faiss::idx_t;
        idx_t k = 10;

        std::unique_ptr<idx_t[]> I(new idx_t[nq * k]);
        std::unique_ptr<float[]> D(new float[nq * k]);
        Timer timer;
        // index.brute_force_search(nb, xb.get(), nq, xq.get(), k, D.get(), I.get());
        auto brute_force_time = timer.elapsed_ns() * 1e-9;
        std::cerr << "Brute force time: " << brute_force_time << "s (simulated)\n";
        return brute_force_time;
    } catch (const std::exception& e) {
        std::cerr << "ERROR in measure_search_performance_brute_force: " << e.what() << "\n";
        throw;
    }
}

nlohmann::json acsg_properties(acsg::IndexACSG &index)
{
    try {
        const int n = index.ntotal;
        const int R = index.acsg.nsg_R;
        std::cerr << "Computing ACSG properties: n=" << n << ", R=" << R << "\n";

        std::vector<int> neighbors(R * n);
        for (int i = 0; i < n; ++i) {
            for (int j = 0; j < R; ++j) {
                neighbors[i * R + j] = index.acsg.final_graph->at(i, j);
            }
        }
        const auto get_range = [&](int u) -> std::tuple<int, int> {
            return {u * R, (u + 1) * R};
        };

        auto props = graph_properties(n, neighbors, get_range);
        std::cerr << "Computed graph properties (type: " << json_type_str(props) << ")\n";
        return props;
    } catch (const std::exception& e) {
        std::cerr << "ERROR in acsg_properties: " << e.what() << "\n";
        throw;
    }
}

int main(int argc, char **argv)
{
    std::cout << "Enterting bench_ACO_TEST" << std::endl;
    setvbuf(stdout, NULL, _IONBF, 0);

    try {
        argparse::ArgumentParser program("train_and_benchmark_ACO");

        program.add_argument("--index_file").required();
        program.add_argument("--dataset").required();
        program.add_argument("--fn_result").required();
        program.add_argument("--trials").default_value(10).scan<'i', int>();
        program.add_argument("--num_aco").default_value(10).scan<'i', int>();
        program.add_argument("--acpg_file").required();
        
        // 参数覆盖选项 (默认值为 -1，表示不覆盖)
        program.add_argument("--alpha").default_value(-1.0f).scan<'g', float>();
        program.add_argument("--beta").default_value(-1.0f).scan<'g', float>();
        program.add_argument("--rho").default_value(-1.0f).scan<'g', float>();
        program.add_argument("--lambda").default_value(-1.0f).scan<'g', float>();
        program.add_argument("--iterations").default_value(-1).scan<'i', int>();
        
        // 【新增】修复报错的关键：添加 rejection 参数
        program.add_argument("--rejection").default_value(-1).scan<'i', int>();
        program.add_argument("--L")
        .help("Search depth L for ACO training")
        .default_value(500) // 默认值设为 500，以防 Python 没传
        .scan<'i', int>();

        // 【SSG 直通模式】可选：直接加载 SSG 图跑蚁群，跳过 bench_ACO
        program.add_argument("--ssg_file")
        .help("SSG graph file path. If set, bypass index_file loading and directly load SSG + run ACO")
        .default_value(std::string(""));
        program.add_argument("--R")
        .help("Graph degree R (only used in SSG direct mode, def: 50)")
        .default_value(50)
        .scan<'i', int>();

        try {
            program.parse_args(argc, argv);
        } catch (const std::runtime_error &err) {
            std::cerr << "Argument parsing error: " << err.what() << std::endl;
            std::cerr << program;
            return 1;
        }

        std::string index_file = program.get<std::string>("--index_file");
        std::string acpg_file = program.get<std::string>("--acpg_file");
        std::string dataset_name = program.get<std::string>("--dataset");
        std::string result_file = program.get<std::string>("--fn_result");
        int num_trials = program.get<int>("--trials");
        int num_aco = program.get<int>("--num_aco");

        // 获取覆盖参数
        float new_alpha = program.get<float>("--alpha");
        float new_beta = program.get<float>("--beta");
        float new_rho = program.get<float>("--rho");
        float new_lambda = program.get<float>("--lambda");
        int new_iterations = program.get<int>("--iterations");
        int new_rejection = program.get<int>("--rejection"); // 【新增】
        int new_L = program.get<int>("--L");
        std::string ssg_file = program.get<std::string>("--ssg_file");
        int ssg_R = program.get<int>("--R");

        // 加载索引
        auto index = std::make_unique<acsg::IndexACSGFlat>();

        if (!ssg_file.empty()) {
            // ============ SSG 直通模式：跳过 bench_ACO，直接加载 SSG 图 ============
            std::cout << "\n========== SSG DIRECT MODE ==========" << std::endl;
            std::cout << "SSG file: " << ssg_file << std::endl;
            std::cout << "Bypassing index_file, loading SSG graph directly.\n" << std::endl;

            // ① 加载 base 数据，获取维度和数量
            DataLoader tmp_loader(dataset_name);
            auto [nb, xb] = tmp_loader.load_base();
            int dim = tmp_loader.dim();
            std::cout << "Base data: N=" << nb << ", dim=" << dim << std::endl;

            // ② 重新创建带正确维度的 IndexACSGFlat
            index = std::make_unique<acsg::IndexACSGFlat>(dim, ssg_R);
            index->verbose = true;
            index->is_trained = true;

            // ③ 把 base 数据灌入 storage
            index->storage->add(nb, xb.get());
            index->ntotal = index->storage->ntotal;

            // ④ 读取 SSG 文件（格式: width | n_ep | eps[] | 逐节点 [deg | neighbors[]] ）
            std::ifstream in(ssg_file, std::ios::binary);
            if (!in.good()) {
                throw std::runtime_error("Cannot open SSG file: " + ssg_file);
            }

            unsigned width;
            in.read((char*)&width, sizeof(unsigned));

            unsigned n_ep = 0;
            in.read((char*)&n_ep, sizeof(unsigned));
            std::vector<unsigned> eps(n_ep);
            in.read((char*)eps.data(), n_ep * sizeof(unsigned));

            // ⑤ 逐节点读邻居，统计最大度数 K
            std::vector<std::vector<unsigned>> adj(nb);
            int K = 0;
            for (faiss::idx_t i = 0; i < nb; i++) {
                unsigned deg;
                in.read((char*)&deg, sizeof(unsigned));
                if (in.eof()) {
                    throw std::runtime_error("SSG file truncated at node " + std::to_string(i) +
                                             " (expected " + std::to_string(nb) + " nodes)");
                }
                adj[i].resize(deg);
                in.read((char*)adj[i].data(), deg * sizeof(unsigned));
                K = std::max(K, static_cast<int>(deg));
            }
            in.close();

            std::cout << "SSG loaded: N=" << nb << ", max_degree(K)=" << K
                      << ", n_ep=" << n_ep
                      << ", EP=" << (n_ep > 0 ? eps[0] : 0) << std::endl;

            // ⑥ 转成 N×K 平铺格式（不足 K 的填 -1），然后调用 acsg.build() 初始化信息素
            std::vector<faiss::idx_t> knng(nb * K, -1);
            for (faiss::idx_t i = 0; i < nb; i++) {
                for (size_t j = 0; j < adj[i].size(); j++) {
                    knng[i * K + j] = static_cast<faiss::idx_t>(adj[i][j]);
                }
            }

            index->acsg.enterpoint = (n_ep > 0) ? static_cast<int>(eps[0]) : 0;
            const acsg::Graph<faiss::idx_t> knn_graph(knng.data(), nb, K);
            index->acsg.build(index->storage, nb, knn_graph, true);
            index->nsg_R = K; // 对齐 graph.K，使后续检查不报错
            index->is_built = true;

            std::cout << "SSG direct load completed. Pheromone initialized to 1.0, weight to 0.0\n";
            std::cout << "========================================\n" << std::endl;

        } else {
            // ============ 原有模式：从 bench_ACO 保存的 index_file 加载 ============
            std::cout << "Loading index from: " << index_file << std::endl;
            index->load(index_file.c_str());
            std::cout << "Index loaded successfully!" << std::endl;
        }

        // 【关键修改】强制覆盖参数
        std::cout << "\n=== Overriding Parameters from Command Line ===" << std::endl;
        if (new_alpha != -1.0f) {
            std::cout << "Overriding Alpha: " << index->acsg.alpha << " -> " << new_alpha << std::endl;
            index->acsg.alpha = new_alpha;
        }
        if (new_beta != -1.0f) {
            std::cout << "Overriding Beta:  " << index->acsg.beta << " -> " << new_beta << std::endl;
            index->acsg.beta = new_beta;
        }
        if (new_rho != -1.0f) {
            std::cout << "Overriding Rho:   " << index->acsg.rho << " -> " << new_rho << std::endl;
            index->acsg.rho = new_rho;
        }
        if (new_lambda != -1.0f) {
            std::cout << "Overriding Lambda:" << index->acsg.lambda << " -> " << new_lambda << std::endl;
            index->acsg.lambda = new_lambda;
        }
        if (new_iterations != -1) {
            std::cout << "Overriding Iterations:" << index->acsg.iterations << " -> " << new_iterations << std::endl;
            index->acsg.iterations = new_iterations;
            index->iterations = new_iterations;
        }
        // 【新增】覆盖 rejection 参数
        if (new_rejection != -1) {
            std::cout << "Overriding Rejection:" << index->acsg.thresholdrej << " -> " << new_rejection << std::endl;
            index->acsg.thresholdrej = new_rejection;
        }
        if (new_L != -1) {
            std::cout << "Overriding Search L: " << index->acsg.search_L << " -> " << new_L << std::endl;
            index->acsg.search_L = new_L;
        }
        std::cout << "==============================================\n" << std::endl;

        // 加载数据集
        DataLoader data_loader(dataset_name);
        
        for (int aco_run = 0; aco_run < 1; ++aco_run) {
            std::cout << "\n===== ACO Run " << (aco_run + 1) << "/" << num_aco << " =====\n";
            index->acsg.search_L = new_L;
            train_ACO(data_loader, *index);
            index->saveACPG(acpg_file.c_str());
            std::cout << "Completed ACO run " << (aco_run + 1) << "/" << num_aco << std::endl;
        }

        // 输出结果
        nlohmann::json output_aco;
        output_aco["dataset"] = dataset_name;
        output_aco["status"] = "ACPG generated";
        std::ofstream ofs_aco(result_file);
        ofs_aco << output_aco.dump(4) << std::endl;

    } catch (const std::exception& e) {
        std::cerr << "FATAL ERROR: " << e.what() << "\n";
        return 1;
    }
    return 0;
}